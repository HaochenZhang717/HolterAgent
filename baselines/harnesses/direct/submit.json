{
  "name": "submit_assessment",
  "description": "Record your assessment of the candidate under review. p_ischemic is your probability that the ST change is ischemic. label is the most likely explanation and must agree with p_ischemic: 'ischemic' when p_ischemic >= 0.5, otherwise the most likely non-ischemic cause. Cite the evidence ids you relied on.",
  "input_schema": {
    "type": "object",
    "properties": {
      "candidate_id": {
        "type": "string"
      },
      "stage": {
        "type": "string",
        "enum": [
          "initial",
          "final"
        ]
      },
      "p_ischemic": {
        "type": "number",
        "description": "0 to 1"
      },
      "label": {
        "type": "string",
        "enum": [
          "ischemic",
          "heart_rate_related",
          "axis_or_position_shift",
          "conduction_change",
          "noise_artifact",
          "other_nonischemic",
          "indeterminate_data"
        ]
      },
      "evidence_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "rationale": {
        "type": "string"
      }
    },
    "required": [
      "candidate_id",
      "stage",
      "p_ischemic",
      "label",
      "evidence_ids",
      "rationale"
    ],
    "additionalProperties": false
  }
}
